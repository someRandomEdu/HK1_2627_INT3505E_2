{
    "$schema": "https://json-schema.org/draft/2020-12/schema",

    "$defs": {
        "Room": {
            "type": "object",

            "properties": {
                "id": { "type": "integer" },
                "roomNumber": { "type": "integer" }
            }
        },

        "Customer": {
            "type": "object",

            "properties": {
                "id": { "type": "integer" },
                "name": { "type": "string" },
                "password": { "type": "string" }
            }
        },

        "Reservation": {
            "type": "object",

            "properties": {
                "id": { "type": "integer" },
                "roomId": { "type": "integer" },
                "customerId": { "type": "integer" },
                "from": { "type": "string", "format": "date-time" },
                "to": { "type": "string", "format": "date-time" }
            }
        }
    }
}
